# ---------------------------------------------------------------------------
# VALMONEY API — environment
# Copy to `.env` (never commit that file) and fill in real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001

# PostgreSQL connection string.
# Local docker compose (see docker-compose.yml): postgresql://valmoney:valmoney@localhost:5433/valmoney
# Hosted (Neon / Supabase / Railway): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://valmoney:valmoney@localhost:5433/valmoney

# Signing key for JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173,https://valmoney.vercel.app

# --- Email (verification codes, password reset, payoff reminders) -----------
# Two transports are supported. Leave everything unset to run in "log only"
# mode: messages are printed to the server console as `[mail:dev] … code=123456`
# instead of being sent, which keeps local dev dependency-free.
#
# 1. HTTPS API (recommended in production — free hosts block SMTP ports).
#    MAIL_PROVIDER=resend   → https://resend.com  (3,000/month, needs a verified sender)
#    MAIL_PROVIDER=sendgrid → https://sendgrid.com (100/day)
#    MAIL_PROVIDER=brevo    → https://brevo.com    (300/day, verify a single sender)
#    MAIL_FROM must be an address the provider lets you send from.
#MAIL_PROVIDER=brevo
#MAIL_API_KEY=
#MAIL_FROM=VALMONEY <no-reply@your-domain.com>
#
# 2. SMTP (self-hosted, or a paid host with outbound port 587 open).
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_SECURE=false
#MAIL_USER=
#MAIL_PASS=
#MAIL_FROM=VALMONEY <no-reply@valmoney.app>
MAIL_FROM=

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Demo data -------------------------------------------------------------
# When true, the API creates the demo account (demo@valmoney.app / Demo1234)
# on boot if the database has no users yet. Off by default; useful on hosts
# without shell access (Render's free plan cannot run `npm run db:seed`).
AUTO_SEED=false
